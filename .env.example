# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_DEBUG=false

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Database ---
# PostgreSQL example. SQLite is used automatically if you leave DATABASE_URL
# empty (good for quick local testing).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hiring_platform

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production refuses to boot when SECRET_KEY is still "change-me".
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Security ---
BCRYPT_ROUNDS=12

# --- Admin (seeded on startup if set) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Platform Admin

# --- CORS (frontend origins, comma-separated) ---
# Production: set to your Vercel URL, e.g. https://hiring-platform.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (SMTP transactional mail; empty SMTP_HOST disables sending) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=noreply@example.com